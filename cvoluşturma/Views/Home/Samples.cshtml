@{
    ViewData["Title"] = "Örnek CV'ler";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/cv-templates.css" asp-append-version="true" />
}

<style>
    .samples-header {
        text-align: center;
        padding: 60px 20px;
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: white;
        margin-bottom: 40px;
        border-radius: 0 0 24px 24px;
        box-shadow: 0 10px 30px rgba(59, 130, 246, 0.2);
    }
    .samples-header h1 { font-weight: 800; font-size: 2.5rem; margin-bottom: 15px; }
    .samples-header p {
        font-size: 1.15rem; color: #f8fafc; font-weight: 500; text-shadow: 0 1px 3px rgba(0,0,0,0.3);
        max-width: 640px; margin: 0 auto;
    }

    .ats-why { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 40px; }
    .ats-why div { background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 12px; padding: 16px; color: #134e4a; font-size: .95rem; }
    .ats-why b { display: block; color: #0f766e; margin-bottom: 4px; }

    .cv-sample-card {
        background: #fff; border-radius: 16px; overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08); transition: transform 0.3s ease, box-shadow 0.3s ease;
        margin-bottom: 30px; border: 1px solid #eaeaea; display: flex; flex-direction: column; height: calc(100% - 30px);
    }
    .cv-sample-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,0.12); }

    .cv-sample-img {
        height: 300px; background: #e2e8f0; border-bottom: 1px solid #eaeaea;
        position: relative; overflow: hidden; padding: 18px 18px 0;
    }
    .cv-sample-page {
        width: 794px; min-height: 1123px; background: #fff; transform-origin: top left;
        box-shadow: 0 6px 20px rgba(0,0,0,0.12); pointer-events: none;
    }
    .cv-sample-img::after {
        content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 60px;
        background: linear-gradient(to bottom, rgba(226,232,240,0), #e2e8f0);
    }

    .cv-sample-body { padding: 24px; flex-grow: 1; display: flex; flex-direction: column; }
    .cv-sample-body h3 { font-size: 1.4rem; font-weight: 700; color: #1e293b; margin-bottom: 6px; }
    .cv-sample-tag { font-size: .8rem; font-weight: 600; color: #166534; background: #dcfce7; border-radius: 10px; padding: 2px 8px; align-self: flex-start; margin-bottom: 10px; }
    .cv-sample-body p { color: #64748b; font-size: 0.95rem; line-height: 1.5; margin-bottom: 20px; flex-grow: 1; }
    .btn-use-template {
        background: #3b82f6; color: white; font-weight: 600; padding: 12px 20px; border-radius: 12px;
        text-align: center; text-decoration: none; transition: background 0.2s ease; display: block; width: 100%;
    }
    .btn-use-template:hover { background: #2563eb; color: white; }
</style>

<div class="samples-header">
    <div class="container">
        <h1>Örnek CV'ler</h1>
        <p>Üç şablonun üçü de işe alım sistemlerinin (ATS) ve yapay zeka ön elemesinin doğru okuyacağı şekilde tasarlandı. Sektörüne uyanı seç, gerisini rehberimiz halleder.</p>
    </div>
</div>

<div class="container mb-5">
    <div class="ats-why">
        <div><b>Tek sütun</b>Sistemler CV'yi yukarıdan aşağı okur. Yan yana kolonlar metni karıştırır.</div>
        <div><b>Gerçek metin PDF</b>Resim olarak kaydedilen CV'ler okunamaz ve elenir. Bizim PDF'imiz seçilebilir metindir.</div>
        <div><b>Standart başlıklar</b>"İş Deneyimi", "Eğitim", "Yetenekler": sistemlerin aradığı başlıklar.</div>
        <div><b>Canlı ATS puanı</b>CV'ni yazarken puanını görür, ilanla karşılaştırıp eksik anahtar kelimeleri bulursun.</div>
    </div>

    <div class="row" id="sampleCards"></div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.6/purify.min.js"></script>
    <script src="~/js/cv-templates.js" asp-append-version="true"></script>
    <script>
    (function () {
        var samples = [
            {
                template: 'ats',
                title: 'Standart',
                text: 'En sade ve en güvenli seçenek. Yazılım, mühendislik, satış, operasyon: her sektörde rahatça kullanılır.',
                data: {
                    personalInfo: { firstName: 'Ahmet', lastName: 'Yılmaz', email: 'ahmet.yilmaz@ornek.com', phone: '+90 555 123 45 67', address: 'İstanbul', linkedin: 'linkedin.com/in/ahmetyilmaz', website: 'github.com/ahmetyilmaz' },
                    profileSummary: 'ASP.NET Core ve React ile 5 yıldır ölçeklenebilir web uygulamaları geliştiren Kıdemli Yazılım Geliştirici. Mikroservis mimarisi, bulut altyapısı (Azure) ve performans optimizasyonunda deneyimli; ekip içinde kod kalitesi ve mentorluk sorumluluğu üstlenir.',
                    experience: [
                        { position: 'Kıdemli Yazılım Geliştirici', company: 'TechCorp A.Ş.', startDate: '2021-03', current: true,
                          description: '- Monolit ödeme sistemini 6 mikroservise ayırarak dağıtım süresini %70 kısalttım.\n- API yanıt süresini önbellekleme ile 850 ms\'den 120 ms\'ye düşürdüm.\n- 4 kişilik ekibe kod incelemesi ve mentorluk yaptım.' },
                        { position: 'Yazılım Geliştirici', company: 'WebStudio', startDate: '2019-06', endDate: '2021-02',
                          description: '- 20+ kurumsal müşteri için ASP.NET MVC tabanlı web uygulamaları geliştirdim.\n- Birim testleri ekleyerek hata oranını %35 azalttım.' }
                    ],
                    education: [{ school: 'Yıldız Teknik Üniversitesi', degree: 'Lisans', field: 'Bilgisayar Mühendisliği', startDate: '2015-09', endDate: '2019-06' }],
                    skills: [{ name: 'C#' }, { name: 'ASP.NET Core' }, { name: 'React' }, { name: 'TypeScript' }, { name: 'SQL Server' }, { name: 'Docker' }, { name: 'Azure' }, { name: 'REST API' }, { name: 'Git' }],
                    languages: [{ name: 'İngilizce', level: 'C1' }, { name: 'Türkçe', level: 'Anadil' }]
                }
            },
            {
                template: 'classic',
                title: 'Klasik',
                text: 'Serif yazı ve ortalı başlık. Hukuk, finans, kamu ve akademi gibi geleneksel sektörlerde güven veren görünüm.',
                data: {
                    personalInfo: { firstName: 'Ayşe', lastName: 'Demir', email: 'ayse.demir@ornek.com', phone: '+90 532 987 65 43', address: 'Ankara', linkedin: 'linkedin.com/in/aysedemir' },
                    profileSummary: 'Ticaret ve şirketler hukuku alanında 6 yıllık deneyime sahip avukat. Birleşme ve devralma süreçleri, sözleşme müzakeresi ve uyum (compliance) danışmanlığında uzman.',
                    experience: [
                        { position: 'Kıdemli Avukat', company: 'ABC Hukuk Bürosu', startDate: '2020-01', current: true,
                          description: '- Toplam değeri 120 milyon TL\'yi aşan 9 birleşme ve devralma işleminde hukuki süreci yönettim.\n- 40+ müvekkil için ticari sözleşme hazırladım ve müzakere ettim.' },
                        { position: 'Avukat', company: 'XYZ Danışmanlık', startDate: '2018-09', endDate: '2019-12',
                          description: '- KVKK uyum projelerinde 15 şirkete danışmanlık verdim.' }
                    ],
                    education: [{ school: 'Ankara Üniversitesi', degree: 'Lisans', field: 'Hukuk Fakültesi', startDate: '2013-09', endDate: '2017-06' }],
                    skills: [{ name: 'Şirketler Hukuku' }, { name: 'Birleşme ve Devralma' }, { name: 'Sözleşme Hukuku' }, { name: 'KVKK' }, { name: 'Uyum (Compliance)' }, { name: 'Müzakere' }],
                    languages: [{ name: 'İngilizce', level: 'C1' }, { name: 'Almanca', level: 'B1' }],
                    certifications: [{ name: 'Arabuluculuk Sertifikası', issuer: 'Adalet Bakanlığı', date: '2021-05' }]
                }
            },
            {
                template: 'modern',
                title: 'Modern',
                text: 'Güçlü başlık ve renk vurgusu, isteğe bağlı fotoğraf. Tasarım, pazarlama ve teknoloji girişimleri için.',
                data: {
                    personalInfo: { firstName: 'Can', lastName: 'Özkan', email: 'can.ozkan@ornek.com', phone: '+90 544 222 33 44', address: 'İzmir', linkedin: 'linkedin.com/in/canozkan', website: 'canozkan.design' },
                    profileSummary: 'Kullanıcı araştırmasını veriyle birleştiren UX/UI Tasarımcı. Fintech ve e-ticaret ürünlerinde 4 yıl; tasarım sistemi kurma ve A/B testleriyle dönüşüm artırma konusunda deneyimli.',
                    experience: [
                        { position: 'Kıdemli UX/UI Tasarımcı', company: 'PayFast', startDate: '2022-02', current: true,
                          description: '- Ödeme akışını yeniden tasarlayarak dönüşüm oranını %18 artırdım.\n- 120+ bileşenden oluşan tasarım sistemini Figma\'da kurdum.\n- 30 kullanıcı görüşmesi yürüterek ürün yol haritasını şekillendirdim.' }
                    ],
                    education: [{ school: 'Dokuz Eylül Üniversitesi', degree: 'Lisans', field: 'Grafik Tasarım', startDate: '2014-09', endDate: '2018-06' }],
                    skills: [{ name: 'Figma' }, { name: 'Kullanıcı Araştırması' }, { name: 'Prototipleme' }, { name: 'Tasarım Sistemleri' }, { name: 'A/B Testi' }, { name: 'HTML/CSS' }, { name: 'Erişilebilirlik' }],
                    languages: [{ name: 'İngilizce', level: 'B2' }],
                    projects: [{ name: 'Mahalle Pazarı Uygulaması', technologies: 'Figma, Maze', description: 'Yerel üreticiler için mobil sipariş uygulaması; kullanılabilirlik testinde görev başarısı %92.' }]
                }
            }
        ];

        var row = document.getElementById('sampleCards');
        samples.forEach(function (s) {
            var tpl = CVTemplateManager.getTemplates().filter(function (t) { return t.id === s.template; })[0];
            var col = document.createElement('div');
            col.className = 'col-lg-4 col-md-6';
            col.innerHTML =
                '<div class="cv-sample-card">' +
                    '<div class="cv-sample-img"><div class="cv-sample-page">' + tpl.render(s.data) + '</div></div>' +
                    '<div class="cv-sample-body">' +
                        '<h3>' + s.title + '</h3><span class="cv-sample-tag">✓ ATS uyumlu</span>' +
                        '<p>' + s.text + '</p>' +
                        '<a href="/Home/Builder?template=' + s.template + '" class="btn-use-template">Bu Şablonla Oluştur</a>' +
                    '</div>' +
                '</div>';
            row.appendChild(col);
        });

        // Önizlemeyi kart genişliğine sığdır
        function fit() {
            document.querySelectorAll('.cv-sample-img').forEach(function (box) {
                var page = box.querySelector('.cv-sample-page');
                page.style.transform = 'scale(' + ((box.clientWidth - 36) / 794) + ')';
            });
        }
        fit();
        window.addEventListener('resize', fit);
    })();
    </script>
}
